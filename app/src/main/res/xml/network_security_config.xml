<?xml version="1.0" encoding="utf-8"?>
<!--
  Home Assistant on a home network is usually plain http://<address>:8123, which Android refuses unless the
  app allows it. The app talks only to the Home Assistant address the person gives it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
